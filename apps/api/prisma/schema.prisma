// DialBrio canonical data model.
// Every tenant-owned table carries organization_id; most also carry sub_account_id.
// Composite indexes lead with organization_id. RLS is a second line of defence (see docs/architecture.md §5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Role {
  admin
  manager
  agent
}

enum LeadState {
  fresh
  warm
  aged
  zombie
}

enum LeadStage {
  new
  attempting
  connected
  qualified
  callback
  appointment
  lost
  dnc
}

enum CampaignStatus {
  draft
  active
  paused
  completed
  archived
}

enum DialStrategyKind {
  human
  ai
}

enum CallState {
  preparing
  dialing
  ringing
  connected
  wrapping_up
  completed
  failed
}

enum CallDirection {
  outbound
  inbound
}

enum DispositionCode {
  interested
  appointment
  callback
  no_answer
  busy
  voicemail
  not_interested
  wrong_number
  dnc
}

enum Channel {
  sms
  call
}

enum MessageStatus {
  queued
  sent
  delivered
  read
  failed
  received
}

enum NumberHealth {
  healthy
  watch
  at_risk
  cooling_down
}

enum ComplianceStatus {
  not_started
  pending
  action_needed
  approved
  rejected
}

enum WebhookStatus {
  received
  processing
  processed
  ignored_duplicate
  ignored_stale
  failed
}

enum QueueItemStatus {
  waiting
  reserved
  dialing
  done
  removed
}

// ─── Tenancy ──────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subAccounts   SubAccount[]
  memberships   Membership[]
  subscriptions Subscription[]

  @@map("organizations")
}

model SubAccount {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  timezone       String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  teams        Team[]
  contacts     Contact[]
  campaigns    Campaign[]

  @@index([organizationId])
  @@map("sub_accounts")
}

model User {
  id           String   @id @db.Uuid
  email        String   @unique
  name         String
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  teamMembers TeamMember[]

  @@map("users")
}

model Membership {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subAccountId   String?  @map("sub_account_id") @db.Uuid // null = organization-wide
  userId         String   @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId, subAccountId])
  @@map("memberships")
}

model Team {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subAccountId   String   @map("sub_account_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subAccount SubAccount   @relation(fields: [subAccountId], references: [id])
  members    TeamMember[]

  @@index([organizationId, subAccountId])
  @@map("teams")
}

model TeamMember {
  teamId         String   @map("team_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@map("team_members")
}

// ─── Integrations & webhooks ──────────────────────────────────────────────

model CrmConnection {
  id                   String    @id @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  subAccountId         String    @map("sub_account_id") @db.Uuid
  provider             String // "ghl"
  externalLocationId   String    @map("external_location_id")
  encryptedCredentials Bytes     @map("encrypted_credentials") // KMS envelope-encrypted OAuth tokens
  tokenExpiresAt       DateTime? @map("token_expires_at")
  lastSyncAt           DateTime? @map("last_sync_at")
  status               String
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([provider, externalLocationId])
  @@index([organizationId, subAccountId])
  @@map("crm_connections")
}

/// Idempotency ledger for every inbound webhook.
model WebhookEvent {
  id             String        @id @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid // resolved after verification
  provider       String
  eventId        String        @map("event_id")
  eventType      String        @map("event_type")
  payload        Json
  payloadHash    String        @map("payload_hash")
  status         WebhookStatus @default(received)
  error          String?
  receivedAt     DateTime      @default(now()) @map("received_at")
  processedAt    DateTime?     @map("processed_at")

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// ─── Contacts & lifecycle ─────────────────────────────────────────────────

model Contact {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  subAccountId      String    @map("sub_account_id") @db.Uuid
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  phoneE164         String?   @map("phone_e164")
  email             String?
  source            String?
  timezone          String?
  ownerId           String?   @map("owner_id") @db.Uuid
  stage             LeadStage @default(new)
  consent           String    @default("unknown")
  externalUpdatedAt DateTime? @map("external_updated_at") // stale-event guard
  deletedAt         DateTime? @map("deleted_at") // tombstone: prevents resurrection
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  subAccount   SubAccount          @relation(fields: [subAccountId], references: [id])
  externalIds  ContactExternalId[]
  leadState    LeadStateRecord?
  stateHistory LeadStateHistory[]
  campaigns    CampaignContact[]

  @@index([organizationId, subAccountId, phoneE164])
  @@index([organizationId, subAccountId, email])
  @@map("contacts")
}

model ContactExternalId {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subAccountId   String   @map("sub_account_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  provider       String
  externalId     String   @map("external_id")
  createdAt      DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id])

  @@unique([subAccountId, provider, externalId])
  @@map("contact_external_ids")
}

/// Current lifecycle state (1:1 with contact). First-class, never a tag.
model LeadStateRecord {
  contactId      String    @id @map("contact_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  state          LeadState
  enteredAt      DateTime  @map("entered_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id])

  @@index([organizationId, state])
  @@map("lead_states")
}

model LeadStateHistory {
  id             String     @id @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  contactId      String     @map("contact_id") @db.Uuid
  fromState      LeadState? @map("from_state")
  toState        LeadState  @map("to_state")
  reason         String
  createdAt      DateTime   @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id])

  @@index([organizationId, contactId, createdAt])
  @@map("lead_state_history")
}

// ─── Campaigns & queues ───────────────────────────────────────────────────

model Campaign {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  subAccountId   String           @map("sub_account_id") @db.Uuid
  name           String
  status         CampaignStatus   @default(draft)
  dialStrategy   DialStrategyKind @default(human) @map("dial_strategy")
  config         Json // validated by packages/validation campaign schema (versioned)
  configVersion  Int              @default(1) @map("config_version")
  launchedAt     DateTime?        @map("launched_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  subAccount SubAccount        @relation(fields: [subAccountId], references: [id])
  contacts   CampaignContact[]
  queues     DialQueue[]

  @@index([organizationId, subAccountId, status])
  @@map("campaigns")
}

model CampaignContact {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  campaignId     String    @map("campaign_id") @db.Uuid
  contactId      String    @map("contact_id") @db.Uuid
  attempts       Int       @default(0)
  lastAttemptAt  DateTime? @map("last_attempt_at")
  removedAt      DateTime? @map("removed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id])

  @@unique([campaignId, contactId])
  @@map("campaign_contacts")
}

model DialQueue {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subAccountId   String   @map("sub_account_id") @db.Uuid
  campaignId     String?  @map("campaign_id") @db.Uuid
  name           String
  priority       Int
  enabled        Boolean  @default(true)
  rules          Json // lead states, sources, retry rules, max attempts, calling window
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  campaign Campaign?       @relation(fields: [campaignId], references: [id])
  items    DialQueueItem[]

  @@index([organizationId, subAccountId, priority])
  @@map("dial_queues")
}

model DialQueueItem {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  queueId        String          @map("queue_id") @db.Uuid
  contactId      String          @map("contact_id") @db.Uuid
  status         QueueItemStatus @default(waiting)
  score          Float // computed priority within the queue
  reason         String // why the lead is here (explainability)
  eligibleAt     DateTime        @map("eligible_at")
  reservedBy     String?         @map("reserved_by") @db.Uuid
  reservedUntil  DateTime?       @map("reserved_until")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  queue DialQueue @relation(fields: [queueId], references: [id])

  @@unique([queueId, contactId])
  @@index([organizationId, queueId, status, eligibleAt, score])
  @@map("dial_queue_items")
}

// ─── Calls ────────────────────────────────────────────────────────────────

model CallAttempt {
  id                 String           @id @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  subAccountId       String           @map("sub_account_id") @db.Uuid
  campaignId         String?          @map("campaign_id") @db.Uuid
  contactId          String           @map("contact_id") @db.Uuid
  agentId            String?          @map("agent_id") @db.Uuid
  strategy           DialStrategyKind
  idempotencyKey     String           @unique @map("idempotency_key")
  complianceDecision Json             @map("compliance_decision") // audited gate result
  createdAt          DateTime         @default(now()) @map("created_at")

  call Call?

  @@index([organizationId, contactId, createdAt])
  @@map("call_attempts")
}

model Call {
  id              String        @id @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  subAccountId    String        @map("sub_account_id") @db.Uuid
  attemptId       String?       @unique @map("attempt_id") @db.Uuid
  providerCallSid String?       @unique @map("provider_call_sid")
  direction       CallDirection
  fromNumber      String        @map("from_number")
  toNumber        String        @map("to_number")
  state           CallState
  failureReason   String?       @map("failure_reason")
  startedAt       DateTime?     @map("started_at")
  answeredAt      DateTime?     @map("answered_at")
  endedAt         DateTime?     @map("ended_at")
  durationSec     Int           @default(0) @map("duration_sec")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  attempt     CallAttempt?    @relation(fields: [attemptId], references: [id])
  events      CallEvent[]
  recordings  CallRecording[]
  disposition Disposition?
  transcript  Transcript?
  review      AiCallReview?

  @@index([organizationId, subAccountId, createdAt])
  @@map("calls")
}

model CallEvent {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  callId          String   @map("call_id") @db.Uuid
  providerEventId String?  @map("provider_event_id")
  type            String
  payload         Json
  occurredAt      DateTime @map("occurred_at")
  createdAt       DateTime @default(now()) @map("created_at")

  call Call @relation(fields: [callId], references: [id])

  @@unique([callId, providerEventId])
  @@map("call_events")
}

model CallRecording {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  callId         String   @map("call_id") @db.Uuid
  storageKey     String   @map("storage_key") // S3 key; served via short-lived signed URLs
  durationSec    Int      @map("duration_sec")
  createdAt      DateTime @default(now()) @map("created_at")

  call Call @relation(fields: [callId], references: [id])

  @@map("call_recordings")
}

model Disposition {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  callId         String          @unique @map("call_id") @db.Uuid
  contactId      String          @map("contact_id") @db.Uuid
  agentId        String?         @map("agent_id") @db.Uuid
  code           DispositionCode
  notes          String?
  source         String          @default("agent") // agent | ai_suggested_confirmed | ai_voice
  createdAt      DateTime        @default(now()) @map("created_at")

  call Call @relation(fields: [callId], references: [id])

  @@index([organizationId, code, createdAt])
  @@map("dispositions")
}

model Callback {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  contactId      String    @map("contact_id") @db.Uuid
  assigneeId     String?   @map("assignee_id") @db.Uuid
  dueAt          DateTime  @map("due_at")
  completedAt    DateTime? @map("completed_at")
  workflowRunId  String?   @map("workflow_run_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, assigneeId, dueAt])
  @@map("callbacks")
}

// ─── Conversations ────────────────────────────────────────────────────────

model Conversation {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  subAccountId   String    @map("sub_account_id") @db.Uuid
  contactId      String    @map("contact_id") @db.Uuid
  assigneeId     String?   @map("assignee_id") @db.Uuid
  lastMessageAt  DateTime? @map("last_message_at")
  unreadCount    Int       @default(0) @map("unread_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  messages Message[]

  @@unique([subAccountId, contactId])
  @@index([organizationId, subAccountId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                String        @id @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  conversationId    String        @map("conversation_id") @db.Uuid
  channel           Channel       @default(sms)
  direction         CallDirection
  body              String
  status            MessageStatus
  providerMessageId String?       @unique @map("provider_message_id")
  fromNumber        String        @map("from_number")
  sentById          String?       @map("sent_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([organizationId, conversationId, createdAt])
  @@map("messages")
}

// ─── Numbers & compliance ─────────────────────────────────────────────────

model PhoneNumber {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  subAccountId   String       @map("sub_account_id") @db.Uuid
  e164           String       @unique
  friendlyName   String       @map("friendly_name")
  providerSid    String       @unique @map("provider_sid")
  capabilities   String[]
  health         NumberHealth @default(healthy)
  coolingUntil   DateTime?    @map("cooling_until")
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  healthChecks NumberHealthCheck[]

  @@index([organizationId, subAccountId])
  @@map("phone_numbers")
}

model NumberHealthCheck {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  phoneNumberId  String       @map("phone_number_id") @db.Uuid
  health         NumberHealth
  spamLabel      String       @map("spam_label")
  answerRate     Float        @map("answer_rate")
  attestation    String?
  signals        Json
  checkedAt      DateTime     @map("checked_at")

  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id])

  @@index([organizationId, phoneNumberId, checkedAt])
  @@map("number_health_checks")
}

model ComplianceRegistration {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  subAccountId   String           @map("sub_account_id") @db.Uuid
  kind           String // a2p_brand | a2p_campaign | stir_shaken | cnam
  externalId     String?          @map("external_id")
  status         ComplianceStatus
  detail         Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([organizationId, subAccountId, kind])
  @@map("compliance_registrations")
}

/// Never deleted. Removal requires admin + audit entry (sets revoked_at).
model DncEntry {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  subAccountId   String?   @map("sub_account_id") @db.Uuid // null = organization-wide
  phoneE164      String    @map("phone_e164")
  source         String // agent_disposition | contact_request | national_registry | import
  reason         String?
  addedById      String?   @map("added_by_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([organizationId, subAccountId, phoneE164])
  @@map("dnc_entries")
}

// ─── Appointments & workflows ─────────────────────────────────────────────

model Appointment {
  id                 String   @id @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  subAccountId       String   @map("sub_account_id") @db.Uuid
  contactId          String   @map("contact_id") @db.Uuid
  campaignId         String?  @map("campaign_id") @db.Uuid
  bookedById         String?  @map("booked_by_id") @db.Uuid
  crmAppointmentId   String?  @map("crm_appointment_id")
  calendarExternalId String   @map("calendar_external_id")
  startsAt           DateTime @map("starts_at")
  status             String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([subAccountId, crmAppointmentId])
  @@index([organizationId, subAccountId, startsAt])
  @@map("appointments")
}

model WorkflowDefinition {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subAccountId   String   @map("sub_account_id") @db.Uuid
  name           String
  version        Int
  steps          Json // [{ type: call|wait|retry|sms|callback|appointment|stop|dnc, ... }]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  runs WorkflowRun[]

  @@unique([subAccountId, name, version])
  @@map("workflow_definitions")
}

model WorkflowRun {
  id                 String    @id @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  definitionId       String    @map("definition_id") @db.Uuid
  contactId          String    @map("contact_id") @db.Uuid
  temporalWorkflowId String    @unique @map("temporal_workflow_id") // deterministic → dedupes
  status             String
  completedSteps     Json      @default("[]") @map("completed_steps")
  startedAt          DateTime  @default(now()) @map("started_at")
  finishedAt         DateTime? @map("finished_at")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id])

  @@index([organizationId, contactId])
  @@map("workflow_runs")
}

// ─── AI ───────────────────────────────────────────────────────────────────

model Transcript {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  callId         String   @unique @map("call_id") @db.Uuid
  provider       String
  segments       Json
  confidence     Float
  createdAt      DateTime @default(now()) @map("created_at")

  call Call @relation(fields: [callId], references: [id])

  @@map("transcripts")
}

model AiCallReview {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  callId          String   @unique @map("call_id") @db.Uuid
  model           String
  intent          String
  confidence      Float
  qaScore         Int      @map("qa_score")
  summary         String
  objections      Json
  complianceFlags Json     @map("compliance_flags")
  coaching        Json
  createdAt       DateTime @default(now()) @map("created_at")

  call Call @relation(fields: [callId], references: [id])

  @@map("ai_call_reviews")
}

// ─── Billing & audit ──────────────────────────────────────────────────────

model UsageEvent {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subAccountId   String?  @map("sub_account_id") @db.Uuid
  kind           String // call_minute | sms_segment | ai_minute | number_month
  quantity       Int
  sourceId       String   @map("source_id") // idempotent per source
  occurredAt     DateTime @map("occurred_at")

  @@unique([kind, sourceId])
  @@index([organizationId, occurredAt])
  @@map("usage_events")
}

model Subscription {
  id                   String   @id @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  stripeSubscriptionId String   @unique @map("stripe_subscription_id")
  plan                 String
  status               String
  currentPeriodEnd     DateTime @map("current_period_end")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("subscriptions")
}

/// Append-only. No updates or deletes (enforced by DB grants).
model AuditLog {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorType      String   @map("actor_type") // user | system | webhook | ai
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  metadata       Json
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, entityType, entityId, createdAt])
  @@map("audit_logs")
}
