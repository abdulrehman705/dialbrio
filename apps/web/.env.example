# "mock" uses the seeded demo repository in src/lib/api/mock. "http" uses the real /v1 API.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:4000

# Sanity (CMS for marketing content and the price book). Project id and dataset are public.
NEXT_PUBLIC_SANITY_PROJECT_ID=u470ygx5
NEXT_PUBLIC_SANITY_DATASET=production
# Standalone Studio (studio/): localhost:3333 in dev, or your deployed *.sanity.studio URL.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Optional, server-only. A Viewer token enables draft previews later; never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
