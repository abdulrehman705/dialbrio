# Sign-in page of the product app (separate repo/deployment). Leave empty to hide "Log in" on the site.
NEXT_PUBLIC_APP_LOGIN_URL=

# Sanity (CMS for marketing content and the price book). Project id and dataset are public.
NEXT_PUBLIC_SANITY_PROJECT_ID=u470ygx5
NEXT_PUBLIC_SANITY_DATASET=production
# Standalone Studio (studio/): localhost:3333 in dev, or your deployed *.sanity.studio URL.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Optional, server-only. A Viewer token enables draft previews later; never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Server-only. Editor-role token that lets /api/waitlist save signups to Sanity (Studio → Waitlist).
# Without it the waitlist form tells visitors signups aren't open yet. Never prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
